{
  "name": "weather-effect-gnome",
  "private": true,
  "version": "2.4.0",
  "description": "Adds a weather effect (snow or rain) to your GNOME wallpaper.",
  "scripts": {
    "install": "tsc -p tsconfig.json && scripts/build.sh -i",
    "build": "tsc -p tsconfig.json && scripts/build.sh",
    "uninstall": "scripts/build.sh -u",
    "delete": "scripts/build.sh -u",
    "watch": "tsc -p tsconfig.json -w"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@girs/gjs": "^4.0.4",
    "@girs/gnome-shell": "^50.0.0"
  }
}
